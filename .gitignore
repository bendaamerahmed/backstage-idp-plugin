# Node / test tooling
node_modules/
npm-debug.log*
.npm/

# Build outputs. The .plugin bundle is a release artifact built by
# scripts/build-plugin.mjs; it is attached to a GitHub release, never committed.
dist/
*.plugin

# Tier 4 integration fixtures. Generated by scripts/fixtures/*.mjs, cached
# locally and in CI, never committed — they are multi-hundred-megabyte
# create-app trees with their own lockfiles.
fixtures/*/
!fixtures/.gitkeep

# Caches produced by the validation harness
.cache/
test/.cache/

# Local editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Never commit secrets, in this repo or in generated fixture output
.env
.env.*
!.env.example
*.local.yaml
